<%-- Shared top of every page. The including page declares the c taglib and sets pageTitle. --%>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<c:set var="me" value="${sessionScope.LOGIN_USER}" />
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> | GasGuard</title>
    <link rel="stylesheet" href="${ctx}/css/app.css">
</head>
<body class="${empty me ? 'is-guest' : 'is-member'}">
<c:if test="${not empty me}">
    <header class="topbar">
        <a class="brand" href="${ctx}/DashboardController">
            <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2c1.5 3.6 5 6.1 5 10.4A5 5 0 0 1 12 17.5a5 5 0 0 1-5-5.1C7 9 9.6 7.4 10.4 4.8c.9 1.8 1.1 3.3.6 5 1.4-.9 1.9-4.4 1-7.8z"/><rect x="5" y="19.5" width="14" height="2.5" rx="1"/></svg>
            GasGuard
        </a>
        <nav class="nav">
            <a href="${ctx}/DashboardController">Dashboard</a>
            <c:if test="${me.can('ALERT', 'READ')}"><a href="${ctx}/AlertController?status=UNRESOLVED">Alerts</a></c:if>
            <c:if test="${me.can('GASEVENT', 'READ')}"><a href="${ctx}/GasEventController">Sessions</a></c:if>
            <c:if test="${me.can('MAINTENANCE', 'READ')}"><a href="${ctx}/MaintenanceController?status=OPEN">Maintenance</a></c:if>
            <c:if test="${me.can('CONTROL', 'READ')}"><a href="${ctx}/ControlController">Control</a></c:if>
            <c:if test="${me.can('HOME', 'READ') or me.can('KITCHENZONE', 'READ') or me.can('ZONE_THRESHOLD', 'READ') or me.can('EMERGENCY_CONTACT', 'READ')}">
                <details class="nav-group">
                    <summary>Homes</summary>
                    <div class="nav-menu">
                        <c:if test="${me.can('HOME', 'READ')}"><a href="${ctx}/HomeController">Homes</a></c:if>
                        <c:if test="${me.can('KITCHENZONE', 'READ')}"><a href="${ctx}/KitchenZoneController">Kitchen zones</a></c:if>
                        <c:if test="${me.can('ZONE_THRESHOLD', 'READ')}"><a href="${ctx}/ZoneThresholdController">Zone thresholds</a></c:if>
                        <c:if test="${me.can('EMERGENCY_CONTACT', 'READ')}"><a href="${ctx}/EmergencyContactController">Emergency contacts</a></c:if>
                    </div>
                </details>
            </c:if>
            <c:if test="${me.can('DEVICE', 'READ') or me.can('GAS_SENSOR', 'READ') or me.can('SENSOR_TYPE', 'READ') or me.can('CALIBRATION', 'READ') or me.can('PROFILE', 'READ')}">
                <details class="nav-group">
                    <summary>Devices</summary>
                    <div class="nav-menu">
                        <c:if test="${me.can('DEVICE', 'READ')}"><a href="${ctx}/DeviceController">Devices</a></c:if>
                        <c:if test="${me.can('GAS_SENSOR', 'READ')}"><a href="${ctx}/GasSensorController">Gas sensors</a></c:if>
                        <c:if test="${me.can('SENSOR_TYPE', 'READ')}"><a href="${ctx}/SensorTypeController">Sensor types</a></c:if>
                        <c:if test="${me.can('CALIBRATION', 'READ')}"><a href="${ctx}/CalibrationController">Calibrations</a></c:if>
                        <c:if test="${me.can('PROFILE', 'READ')}"><a href="${ctx}/OperatingProfileController">Compensation profiles</a></c:if>
                    </div>
                </details>
            </c:if>
            <c:if test="${me.can('USER', 'READ') or me.can('AUDIT', 'READ')}">
                <details class="nav-group">
                    <summary>Admin</summary>
                    <div class="nav-menu">
                        <c:if test="${me.can('USER', 'READ')}"><a href="${ctx}/UserController">Users</a></c:if>
                        <c:if test="${me.can('AUDIT', 'READ')}"><a href="${ctx}/AuditController">Audit log</a></c:if>
                    </div>
                </details>
            </c:if>
        </nav>
        <div class="who">
            <a class="who-name" href="${ctx}/AccountController" title="My account"><c:out value="${me.fullName}"/></a>
            <span class="role-tag"><c:out value="${me.roleDisplayName}"/></span>
            <a class="who-out" href="${ctx}/LogoutController">Sign out</a>
        </div>
    </header>
    <div class="hazard" aria-hidden="true"></div>
</c:if>
<main class="page">
<c:if test="${not empty sessionScope.FLASH}">
    <p class="notice notice-${sessionScope.FLASH_TYPE}" role="status"><c:out value="${sessionScope.FLASH}"/></p>
    <c:remove var="FLASH" scope="session"/>
    <c:remove var="FLASH_TYPE" scope="session"/>
</c:if>
